# Django
SECRET_KEY=nuru-hackathon-demo-key
DEBUG=True
# Comma-separated. Empty falls back to ['*'].
ALLOWED_HOSTS=
# Comma-separated. Ignored while DEBUG=True.
CORS_ALLOWED_ORIGINS=

# Database. Empty falls back to local sqlite3.
# In Railway/production, provide Railway PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:password@host:port/railway
DATABASE_URL=

# Transactional email (OTP codes, password reset links).
# Leave RESEND_API_KEY empty in dev: codes are logged to the console instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NURU <onboarding@resend.dev>

# Mono — bank account linking.
# Sandbox vs live is decided by the key prefix (test_sk_… / live_sk_…).
MONO_SECRET_KEY=
MONO_BASE_URL=https://api.withmono.com
MONO_REDIRECT_URL=https://nuru-bmoni.up.railway.app/mono/callback

# Where the Flutter web build is served, used to build links inside emails.
FRONTEND_BASE_URL=https://nuru-bmoni.up.railway.app

# Fernet key for encrypting stored Mono access tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty derives one from SECRET_KEY — fine for dev, set it explicitly in production.
FIELD_ENCRYPTION_KEY=

# Auth tunables (defaults shown)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=60

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

